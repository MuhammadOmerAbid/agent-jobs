# LLM (same Groq-primary/Gemini-fallback client as agent-ats; both are free-tier)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
LLM_PRIMARY=groq
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash

# Shared SQLite DB — must be set to the SAME absolute path in agent-ats/bk/.env
JOBS_DB_PATH=E:/Company/agent-jobs/data/jobs.db

# Free-with-signup sources (omit any you don't have — that fetcher just no-ops)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
FINDWORK_API_TOKEN=
JOOBLE_API_KEY=
THEMUSE_API_KEY=

# Optional: schedule override (defaults to 08:00 local)
AGENT_JOBS_SCHEDULE_HOUR=8
AGENT_JOBS_SCHEDULE_MINUTE=0

# Optional, deferred feature (Telegram digest not wired in yet)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
